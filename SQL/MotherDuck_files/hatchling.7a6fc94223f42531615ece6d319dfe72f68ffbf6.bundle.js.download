`.trim()}function buildDucklingTopQueriesFromResultSQL(Oe,Ae,Ne,je){return buildTopQueriesFromSourceSQL(`SELECT * FROM ${quoteSqlIdentifier(Oe)}`,Ae,Ne,je)}function buildDucklingSizeSpansFromResultSQL(Oe){return buildDucklingSizeSpansFromOrderedSQL(`
