  SELECT
    user_name,
    duckling_id,
    instance_type,
    start_time,
    epoch_ms(start_time)::BIGINT AS start_ms,
    epoch_ms(COALESCE(end_time, start_time))::BIGINT AS end_ms,
    wait_time,
    bytes_spilled_to_disk,
    error_message
  FROM ${Ae}
  CROSS JOIN params
  WHERE start_time >= params.window_start
    AND start_time <= params.window_end
    AND duckling_id IS NOT NULL
),
summary AS (
  SELECT
    user_name,
    duckling_id,
    COALESCE(
      STRING_AGG(DISTINCT instance_type, ', ' ORDER BY instance_type)
        FILTER (WHERE instance_type IS NOT NULL),
      ''
    ) AS instance_types,
    CAST(COUNT(*) AS INTEGER) AS query_count,
    CAST(COUNT(DISTINCT date_trunc('minute', start_time)) AS INTEGER) AS active_minutes,
    CAST(COUNT(*) FILTER (WHERE wait_time > INTERVAL 1 SECOND) AS INTEGER) AS high_wait_count,
    CAST(COUNT(*) FILTER (WHERE bytes_spilled_to_disk > 0) AS INTEGER) AS spill_count,
    CAST(COUNT(*) FILTER (WHERE error_message IS NOT NULL AND error_message != '') AS INTEGER) AS error_count
  FROM filtered_query_history
  GROUP BY user_name, duckling_id
),
spark_occupancy AS (
  SELECT
    filtered_query_history.user_name,
    filtered_query_history.duckling_id,
    unnest(
      generate_series(
        params.bucket_start_ms
          + CAST(
            FLOOR((filtered_query_history.start_ms - params.bucket_start_ms)::DOUBLE / params.bucket_ms) * params.bucket_ms
            AS BIGINT
          ),
        params.bucket_start_ms
          + CAST(
            FLOOR(
              (
                GREATEST(
                  filtered_query_history.start_ms + 1,
                  LEAST(filtered_query_history.end_ms, params.window_end_ms)
                ) - params.bucket_start_ms
              )::DOUBLE
              / params.bucket_ms
            ) * params.bucket_ms
            AS BIGINT
          ),
        params.bucket_ms
      )
    ) AS bucket_ts_ms
  FROM filtered_query_history
  CROSS JOIN params
),
spark_counts AS (
  SELECT
    spark_occupancy.user_name,
    spark_occupancy.duckling_id,
    spark_occupancy.bucket_ts_ms,
    CAST(COUNT(*) AS INTEGER) AS bucket_query_count
  FROM spark_occupancy
  GROUP BY spark_occupancy.user_name, spark_occupancy.duckling_id, spark_occupancy.bucket_ts_ms
),
spark_scaffold AS (
  SELECT
    summary.user_name,
    summary.duckling_id,
    unnest(
      generate_series(
        (SELECT bucket_start_ms FROM params),
        (SELECT bucket_end_ms FROM params) - (SELECT bucket_ms FROM params),
        (SELECT bucket_ms FROM params)
      )
    ) AS bucket_ts_ms
  FROM summary
),
spark_rollup AS (
  SELECT
    spark_scaffold.user_name,
    spark_scaffold.duckling_id,
    spark_scaffold.bucket_ts_ms AS ts_ms,
    COALESCE(spark_counts.bucket_query_count, 0) AS count
  FROM spark_scaffold
  LEFT JOIN spark_counts
    ON spark_counts.user_name = spark_scaffold.user_name
   AND spark_counts.duckling_id = spark_scaffold.duckling_id
   AND spark_counts.bucket_ts_ms = spark_scaffold.bucket_ts_ms
),
spark_bounds AS (
  SELECT
    user_name,
    duckling_id,
    MIN(ts_ms) AS t1,
    MAX(ts_ms) AS t2,
    GREATEST(MAX(ts_ms) - MIN(ts_ms), 1) AS diff
  FROM spark_rollup
  GROUP BY user_name, duckling_id
),
spark_am4 AS (
  SELECT
    spark_rollup.user_name,
    spark_rollup.duckling_id,
    MIN(spark_rollup.ts_ms) AS min_t,
    arg_min(spark_rollup.count::DOUBLE, spark_rollup.ts_ms) AS argmin_tv,
    MAX(spark_rollup.ts_ms) AS max_t,
    arg_max(spark_rollup.count::DOUBLE, spark_rollup.ts_ms) AS argmax_tv,
    MIN(spark_rollup.count::DOUBLE) AS min_v,
    arg_min(spark_rollup.ts_ms, spark_rollup.count::DOUBLE) AS argmin_vt,
    MAX(spark_rollup.count::DOUBLE) AS max_v,
    arg_max(spark_rollup.ts_ms, spark_rollup.count::DOUBLE) AS argmax_vt,
    ROUND(
      (SELECT spark_pixels FROM params)
      * (spark_rollup.ts_ms - spark_bounds.t1)
      / spark_bounds.diff
    ) AS bin
  FROM spark_rollup
  INNER JOIN spark_bounds
    ON spark_bounds.user_name = spark_rollup.user_name
   AND spark_bounds.duckling_id = spark_rollup.duckling_id
  GROUP BY spark_rollup.user_name, spark_rollup.duckling_id, bin
),
spark_unnested AS (
  SELECT
    spark_am4.user_name,
    spark_am4.duckling_id,
    unnest([
      [spark_am4.min_t, spark_am4.argmin_tv],
      [spark_am4.argmin_vt, spark_am4.min_v],
      [spark_am4.argmax_vt, spark_am4.max_v],
      [spark_am4.max_t, spark_am4.argmax_tv]
    ]) AS point
  FROM spark_am4
),
spark_series AS (
  SELECT
    spark_unnested.user_name,
    spark_unnested.duckling_id,
    LIST(
      {
        ts: epoch_ms(CAST(point[1] AS BIGINT)),
        count: point[2]
      }
      ORDER BY point[1]
    ) AS query_spark
  FROM spark_unnested
  GROUP BY spark_unnested.user_name, spark_unnested.duckling_id
)
SELECT
  summary.user_name,
  summary.duckling_id,
  summary.instance_types,
  summary.query_count,
  summary.active_minutes,
  summary.high_wait_count,
  summary.spill_count,
  summary.error_count,
  spark_series.query_spark
FROM summary
INNER JOIN spark_series
  ON spark_series.user_name = summary.user_name
 AND spark_series.duckling_id = summary.duckling_id
ORDER BY query_count DESC
