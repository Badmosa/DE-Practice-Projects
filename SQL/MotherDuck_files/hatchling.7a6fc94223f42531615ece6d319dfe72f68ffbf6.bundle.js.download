-- which formats dates incorrectly, and accept the suggested fixes.

SELECT created_date, agency, complaint_type, landmark, resolution_description
FROM sample_data.nyc.service_requests 
WHERE created_date >= 21-01-02 AND created_date <= '2021-01-31'`,exampleQueryIcebergeLoad=`-- Want to load data from a blob store? MotherDuck supports S3, GCS, R2, Azure and more.
-- The data can be in a variety of data formats, including:
-- Parquet, Iceberg, Delta Lake, CSV, and JSON.

-- This cell shows how to make an unauthenticated fetch of Iceberg data from S3.
-- To access private data, set your credentials in the “Secrets” section of “Settings”,
-- accessible from the menu at the top left of the page.

-- You’ll note we’re also running multiple statements in this cell in order to
-- create the database, use it, load the data, and then query it.

-- To re-run this cell, first drop the created database with the following:
-- DROP SHARE IF EXISTS my_shared_example_data;
-- DROP DATABASE my_shared_db;

CREATE DATABASE IF NOT EXISTS my_shared_db;
USE my_shared_db;

CREATE OR REPLACE TABLE aggregated_order_data AS
(
  SELECT l_shipdate, AVG(l_discount), SUM(l_extendedprice) 
  FROM 
    iceberg_scan('https://motherduck-demo.s3.amazonaws.com/iceberg/lineitem_iceberg', allow_moved_paths=true) 
  GROUP BY ALL
  ORDER BY l_shipdate
);

-- This is shorthand for “SELECT * FROM aggregated_order_data”.
FROM aggregated_order_data;`,exampleQueryCreateShare=`-- Want to share what you just did with your colleagues? In the panel to the left, click
-- the three dots next to the my_shared_db database and choose “Share”.  Change the name 
-- of the share to something interesting, and share it with your whole organization.

-- You can invite other users by selecting “Invite your team” from the menu at the top left of the page.
-- Then your team can see the shared data listed under the “Shared with me” section of the left bar.

-- Alternatively, run the SQL below to create the share.

-- To re-run, first drop the created share with the following:
-- DROP SHARE IF EXISTS my_shared_example_data;

CREATE SHARE my_shared_example_data FROM my_shared_db (ACCESS ORGANIZATION, VISIBILITY DISCOVERABLE);`,duckDBUIShowMeTheBasics={setup:`/** 
 DuckDB UI Basics
 
 This notebook demonstrates the fundamental features of the DuckDB UI.

 It uses an in-memory database named 'memory'.
 If you started DuckDB without a database file, this should already exist.
 If not, the following command will create it.
  */

ATTACH IF NOT EXISTS ':memory:' AS memory;`,createTableFromURL:`/**
 Loading Data
 
 Let's create a table from an external file for efficient querying.
 When you execute this query, the "trains" table will appear in the 
 memory database under the attached databases list.

Tips:
- In DuckDB, writing FROM <tbl> is equivalent to writing SELECT * FROM <tbl>
- Click on the table name to view a summary in the bottom left panel.
 */

CREATE OR REPLACE TABLE trains AS
FROM "http://blobs.duckdb.org/train_services.parquet";`,queryNewTable:`/**
Exploring Column Diagnostics
 
When running a query, your results will appear below the editor
and column diagnostics will appear on the right panel, providing an 
overview of your data without requiring additional queries.

Run this query, then click on column names in the right panel to view detailed statistics.
*/

FROM trains;`,copyToFileSystem:`/**
Working with Files
 
The DuckDB UI can read and write files just like in other clients.
This example demonstrates exporting data to a CSV file and then
querying that same file.
 */

-- First, copy this table to a CSV file in your filesystem. 
-- This file will appear in the working directory
-- where you're running DuckDB.
COPY (FROM trains) TO "./trains.csv";

-- Now, query the file directly.
FROM "./trains.csv";`};function exampleNotebookCells(Oe){const Ae=[];let Ne=1;return Oe.headerCell&&!Oe.httpDuckDBMode&&Ae.push({cellId:Ne++,query:"-- Get started by running the examples below!"}),Oe.httpDuckDBMode?(Ae.push({cellId:Ne++,query:duckDBUIShowMeTheBasics.setup}),Ae.push({cellId:Ne++,useDatabase:"memory",query:duckDBUIShowMeTheBasics.createTableFromURL}),Ae.push({cellId:Ne++,useDatabase:"memory",query:duckDBUIShowMeTheBasics.queryNewTable}),Ae.push({cellId:Ne++,useDatabase:"memory",query:duckDBUIShowMeTheBasics.copyToFileSystem})):(Ae.push({cellId:Ne++,query:exampleQueryServiceRequests,useDatabase:"sample_data"}),Ae.push({cellId:Ne++,query:exampleQueryServiceRequestsFixIt,useDatabase:"sample_data"}),Ae.push({cellId:Ne++,query:exampleQueryIcebergeLoad}),Ae.push({cellId:Ne++,query:exampleQueryCreateShare})),Ae}function welcomeNotebookContent(Oe){return{notebookSerializationFormat:3,version:1,cells:exampleNotebookCells(Oe),currentDatabase:null,viewMode:{mode:"default"}}}async function createNewUserContent(){var Ue;const Oe=((Ue=useMDUIStore.getState().config)==null?void 0:Ue.duckDBMode)==="HTTP",Ae=`welcome-notebook_${randomString$1()}`,Ne=Oe?"DuckDB UI basics":"Welcome to MotherDuck!",je=welcomeNotebookContent({headerCell:!0,httpDuckDBMode:Oe});try{const Be=await createMomNotebook(Ae,je,Ne);await setMomUserProperty(userPropertyKeys.current_notebook_entity_id,Be.id)}catch(Be){globalLogger.warn("Failed to create welcome notebook",{error:Be})}}function createHiringConsoleMessage(){console.log(`%c
