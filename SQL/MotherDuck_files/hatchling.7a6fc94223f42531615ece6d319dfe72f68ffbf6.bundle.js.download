    -- between 60 seconds and 1 hour: group by second (max 3,600 points)
    when millis <= ${INTERVAL_THRESHOLDS.second} and not is_date_type then interval 1 second
    -- less than a day: group by minute (max 1,440 points)
    when millis <= ${INTERVAL_THRESHOLDS.minute} and not is_date_type then interval 1 minute
    -- less than a week: group by hour (max 168 points)
    when millis <= ${INTERVAL_THRESHOLDS.hour} and not is_date_type then interval 1 hour
    -- less than 20 years: group by day (max 7,300 points)
    when millis <= ${INTERVAL_THRESHOLDS.day} then interval 1 day
    -- less than 50 years: group by month
